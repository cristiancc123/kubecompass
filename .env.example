ELASTICSEARCH_URL=https://my-vectordb-project-c9625c.es.us-east4.gcp.elastic.cloud:443
ELASTICSEARCH_API_KEY=
DASH0_AUTH_TOKEN=
DASH0_OTLP_ENDPOINT=https://ingress.us-west-2.aws.dash0.com
# Optional: Dash0 dataset, defaults to the organization's default dataset
DASH0_DATASET=
