{
  "name": "kubecompass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Find the right talk and the right people at KubeCon.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env --import tsx src/server.ts",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "ingest": "node --env-file=.env --import tsx scripts/ingest.ts",
    "setup-attendees": "node --env-file=.env --import tsx scripts/setup-attendees.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@elastic/elasticsearch": "^9.1.0",
    "@hono/node-server": "^1.14.0",
    "@hono/otel": "^1.3.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.301.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.301.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "hono": "^4.7.0",
    "node-html-parser": "^9.0.7"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
